{
  "name": "dsh-quota-dock",
  "version": "0.3.1",
  "description": "Composer-dock quota strip: Command Code 5h/weekly/monthly windows with fill bars and percentages, plus DeepSeek's peak/off-peak period.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-than-coca/dsh-quota-dock.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "quota",
    "command-code",
    "deepseek"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CONTRACT.md",
    "test/smoke.cjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
